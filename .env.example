# Copy to .env (git-ignored) and fill in. Never commit real values.
# Scrapers read these as process environment variables (export them, or use your shell's env loader);
# they do not load .env files themselves. research-assistant/ has its own .env.example.

# ── Output and data directories ────────────────────────────────────
# Where the scrapers write their JSON output files.
# Documented default: the current directory. NOTE (audit finding): several scrapers and utils/merge_national.py
# still fall back to a Windows path on the author's machine when this is unset, so set it explicitly.
OUTPUT_DIR=./data

# Where utils/merge_national.py and utils/make_progress_charts.py read the per-court JSON files
# (normally the same folder as OUTPUT_DIR).
DATA_DIR=./data

# ── Canada (CanLII) ────────────────────────────────────────────────
# Free API key: request one at https://developer.canlii.org/ . Read the API terms before collecting:
# the CanLII API gives metadata only and CanLII's terms restrict systematic downloading.
CANLII_API_KEY=YOUR_CANLII_API_KEY

# ── Legal Data Hunter (used by scrapers/canada/canada_ldh_scraper.py) ──
# Semantic and keyword legal search (legaldatahunter.com). Required only for that one scraper.
# (Earlier versions of this file named it LEGAL_DATA_HUNTER_API_KEY, which no script reads.)
LDH_API_KEY=YOUR_LDH_API_KEY

# ── Validation tools (validation/residual_audit.py, validation/transformer_classifier.py) ──
# Path to the coded dataset (water_law_global_coded.csv), obtained from the Zenodo deposit
# (https://doi.org/10.5281/zenodo.19836413) or produced by utils/jurimetric_coding.py.
CODED_CSV=./data/water_law_global_coded.csv
