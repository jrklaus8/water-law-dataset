{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dataset",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "version",
    "kind",
    "licence",
    "checksum_sha256",
    "privacy_status",
    "permitted_uses",
    "variables",
    "path",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^DS-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "kind": {
      "enum": [
        "authentic",
        "synthetic"
      ]
    },
    "description": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SRC-"
      }
    },
    "licence": {
      "type": "string"
    },
    "checksum_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "path": {
      "type": "string"
    },
    "row_count": {
      "type": "integer"
    },
    "privacy_status": {
      "enum": [
        "public_no_personal_data",
        "anonymised",
        "synthetic",
        "restricted"
      ]
    },
    "privacy_notes": {
      "type": "string"
    },
    "permitted_uses": {
      "type": "array",
      "items": {
        "enum": [
          "view",
          "filter",
          "export",
          "redistribute",
          "derive"
        ]
      },
      "minItems": 1
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "string",
              "integer",
              "number",
              "category",
              "boolean"
            ]
          },
          "description": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
