{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "method",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "description",
    "required_inputs",
    "assumptions",
    "execution_environment"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^MTH-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SRC-"
      }
    },
    "required_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution_environment": {
      "enum": [
        "browser",
        "workflow",
        "ai_assisted",
        "manual"
      ]
    },
    "associated_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
